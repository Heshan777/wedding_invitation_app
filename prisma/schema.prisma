generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

model Guest {
    id              String    @id @default(cuid())
    token           String    @unique @default(cuid())
    displayName     String
    salutation      String
    inviteType      String    @default("SINGLE")
    tableNumber     Int
    notes           String?
    phone           String?
    rsvpStatus      String    @default("PENDING") // PENDING | ATTENDING | DECLINED
    attendeeCount   Int       @default(1)
    dietary         String?   @default("NONE") // NONE | VEGETARIAN | VEGAN | HALAL | GLUTEN_FREE | OTHER
    rsvpMessage     String?
    viewedAt        DateTime?
    rsvpSubmittedAt DateTime?
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
}

model GuestbookWish {
    id          String   @id @default(cuid())
    authorName  String
    message     String
    likes       Int      @default(0)
    createdAt   DateTime @default(now())
}

model EventSettings {
    id                   String   @id @default("singleton")
    coupleNames          String   @default("Sandharu & Sanduni")
    hostIntro            String   @default("With gratitude and joyful hearts, we cordially invite")
    invitationBody       String   @default("to join us as we celebrate this special day...")
    eventDate            DateTime
    venueName            String
    venueAddress         String
    venueLat             Float
    venueLng             Float    @default(79.9426)
    heroImageUrl         String?  @default("/uploads/preshoot-photo-Pragya-Siddharth-Pix-1788547160301-318.jpg")
    heroVideoUrl         String?  @default("/uploads/preshoot-video-0903-1788547888302-520.mp4")
    videoThumbnailUrl    String?  @default("/uploads/preshoot-photo-Pragya-Siddharth-Pix-1788547160301-318.jpg")

    galleryJson          String?
    blessingImageUrl     String?  @default("/uploads/preshoot-photo-OIP2-1788547184704-193.webp")
    welcomeImageUrl      String?  @default("/uploads/preshoot-photo-423f40cc366ebcbcb01c-1788547168710-655.jpg")
    placeCardImageUrl    String?  @default("/uploads/preshoot-photo-e5a487a560c507085cda-1788547177206-113.jpg")
    placeCardNote        String?  @default("Thank you for sharing our joy and celebrating with us!")

    musicUrl             String?  @default("/audio/background.mp3")
    dressCodeTitle       String?  @default("Royal Splendor & Black Tie")
    dressCodeDescription String?  @default("Traditional Sri Lankan elegance or formal evening attire in warm tones of gold, burgundy, and ivory.")
    timelineJson         String?
    contactPhone         String?  @default("+94 77 123 4567")
}




