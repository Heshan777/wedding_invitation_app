# =========================================================================
# WedLink SaaS Production & Development Environment Configuration
# =========================================================================

# 1. Admin Master Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production
ADMIN_PASSWORD_HASH=

# 2. JWT Session Security (32+ character random secret)
SESSION_SECRET="generate-a-strong-random-32-character-session-secret-here"

# 3. PostgreSQL Database Connection (Supabase or Neon)
# NOTE: For Supabase on Vercel/serverless, use port 6543 with ?pgbouncer=true&connection_limit=1&sslmode=require
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# 4. Cloudinary Media Storage (Photos, Audio & Video streaming)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="gx8aajk0"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="wedding_uploads"

# 5. Public Application Domain (Used for WhatsApp invitations, OpenGraph metadata, QR codes)
NEXT_PUBLIC_APP_URL="https://wedding-invitation-app-silk.vercel.app"

# 6. Customer Support & WhatsApp Concierge (Set to your actual Sri Lankan phone number)
NEXT_PUBLIC_SUPPORT_PHONE="94771234567"
NEXT_PUBLIC_SUPPORT_EMAIL="support@wedlink.lk"

# 7. Sri Lankan Bank Transfer Details for Customer Package Upgrades
NEXT_PUBLIC_BANK_NAME="Commercial Bank of Ceylon"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="WedLink Invitations"
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER="8009123456"
NEXT_PUBLIC_BANK_BRANCH="Colombo Grand Central"
NEXT_PUBLIC_FRIMI_NUMBER="0771234567"
