# Wedding Invitation App Environment Configuration
# Default Admin Credentials (Change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_in_production

# JWT Secret for Admin Session (Must be at least 32 random characters in production)
SESSION_SECRET="generate-a-strong-random-32-character-session-secret-here"

# Database Connection URL (SQLite or PostgreSQL / Supabase)
DATABASE_URL="file:./dev.db"

# Cloudinary Media Storage (Photos, Audio Tracks & Pre-shoot Videos)
# Create a free account at https://cloudinary.com
# 1. Cloud Name (Dashboard -> Product Environment -> Cloud Name)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="gx8aajk0"
# 2. Upload Preset (Settings -> Upload -> Upload presets -> Add unsigned preset)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="wedding_uploads"

# Public Application URL (Used for WhatsApp invitations, CSV exports, QR codes)
NEXT_PUBLIC_APP_URL="https://wedding-invitation-app-silk.vercel.app"
